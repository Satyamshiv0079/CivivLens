# Backend Environment Variables
SERVER_PORT=8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civiclens_db
POSTGRES_USER=civiclens_user
POSTGRES_PASSWORD=civiclens_pass
# IMPORTANT: Generate a secure 256-bit (or larger) Base64 secret before running in production.
# Example command: openssl rand -base64 32
JWT_SECRET=YOUR_SECURE_RANDOMLY_GENERATED_BASE64_SECRET_MIN_256_BITS
JWT_EXPIRATION_MS=86400000
SEED_DEMO_DATA=false
UPLOAD_DIR=./uploads
