# ==========================================
# CivicLens - Environment Variables Template
# Copy this file to .env and adjust as needed
# ==========================================

# Database Configuration
POSTGRES_DB=civiclens_db
POSTGRES_USER=civiclens_user
POSTGRES_PASSWORD=civiclens_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# IMPORTANT: Generate a secure 256-bit (or larger) Base64 secret before running in production.
# Example command: openssl rand -base64 32
JWT_SECRET=YOUR_SECURE_RANDOMLY_GENERATED_BASE64_SECRET_MIN_256_BITS
JWT_EXPIRATION_MS=86400000
# Set to true to initialize demo users (only recommended in development/testing environments)
SEED_DEMO_DATA=false

# File Uploads
UPLOAD_DIR=./uploads

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
